<Window x:Class="IdeaNest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IdeaNest.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FabButton" TargetType="Button">
            <Setter Property="Width"  Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background"  Value="#3F8EFC" />
            <Setter Property="Foreground"  Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"    Value="28" />
            <Setter Property="FontWeight"  Value="Bold" />
            <Setter Property="Cursor"      Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="28"
                                Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.35"
                                                  BlurRadius="10" ShadowDepth="2" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F7DEB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2566C6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl"        Key="N" Command="{Binding NewWorkspaceCommand}" />
        <KeyBinding Modifiers="Ctrl"        Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Ctrl"        Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift"  Key="S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift"  Key="N" Command="{Binding AddIdeaCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="#F2F2F2">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規作成(_N)" Command="{Binding NewWorkspaceCommand}" />
                <MenuItem Header="開く(_O)..." Command="{Binding OpenCommand}" />
                <Separator />
                <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" />
                <MenuItem Header="名前を付けて保存(_A)..." Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="新規カード追加(_N)" InputGestureText="Ctrl+Shift+N"
                          Command="{Binding AddIdeaCommand}" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="アーカイブを表示" IsCheckable="True" IsChecked="{Binding ShowArchived, Mode=TwoWay}" />
            </MenuItem>
        </Menu>

        <!-- Search & filter bar -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="タイトル・本文・タグを検索" />
                <TextBlock Grid.Column="1" Text="タグ:" VerticalAlignment="Center" Margin="12,0,4,0" />
                <TextBlock Grid.Column="2" Text="{Binding SelectedTag}" VerticalAlignment="Center" FontWeight="Bold" MinWidth="60" />
                <CheckBox Grid.Column="3" Content="アーカイブを表示"
                          IsChecked="{Binding ShowArchived, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Body: tag list + cards -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F6F6F6" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="タグ" FontWeight="Bold" Margin="0,0,0,6" />
                    <Button DockPanel.Dock="Top" Content="(すべて)" Command="{Binding ClearTagCommand}"
                            Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left" />
                    <ListBox ItemsSource="{Binding AvailableTags}"
                             SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='#{0}'}" Margin="2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <ItemsControl ItemsSource="{Binding VisibleCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240" Height="200" Margin="6"
                                    CornerRadius="6" BorderThickness="1" BorderBrush="#CCCCCC"
                                    Background="{Binding BackgroundBrush, Converter={StaticResource HexToBrush}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.EditIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <DockPanel Margin="8">
                                    <Grid DockPanel.Dock="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="★" Foreground="#E0A800" FontSize="16"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                                   FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="📌" ToolTip="ピン留め切替"
                                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource FlatButton}" />
                                        <Button Content="編集"
                                                Command="{Binding DataContext.EditIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource FlatButton}" />
                                        <Button Content="📥" ToolTip="アーカイブ切替"
                                                Command="{Binding DataContext.ToggleArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource FlatButton}" />
                                        <Button Content="削除"
                                                Command="{Binding DataContext.DeleteIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource FlatButton}" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding UpdatedAtText}"
                                               FontSize="10" Foreground="#666" Margin="0,4,0,2" />
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TagsText}"
                                               Foreground="#0066AA" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding TagsText, Converter={StaticResource StringToVis}}" />
                                    <TextBlock Text="{Binding BodyPreview}"
                                               TextWrapping="Wrap" Margin="0,4,0,4"
                                               FontSize="12" Foreground="#222" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Floating action button: 新規アイデア -->
            <Button Style="{StaticResource FabButton}"
                    Content="＋"
                    ToolTip="新しいアイデアを追加 (Ctrl+Shift+N)"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Command="{Binding AddIdeaCommand}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
