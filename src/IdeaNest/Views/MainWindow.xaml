<Window x:Class="IdeaNest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IdeaNest.ViewModels"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl"        Key="N" Command="{Binding NewWorkspaceCommand}" />
        <KeyBinding Modifiers="Ctrl"        Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Ctrl"        Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift"  Key="S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift"  Key="N" Command="{Binding AddIdeaCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift"  Key="C" Command="{Binding CopyAllMarkdownCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu (kept minimal: no border below) -->
        <Menu DockPanel.Dock="Top" Background="Transparent" Padding="4,2">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規作成(_N)" InputGestureText="Ctrl+N" Command="{Binding NewWorkspaceCommand}" />
                <MenuItem Header="開く(_O)..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <Separator />
                <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                <MenuItem Header="名前を付けて保存(_A)..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="エクスポート(_E)">
                    <MenuItem Header="Markdown風テキスト(_M)..." Command="{Binding ExportMarkdownCommand}" />
                    <MenuItem Header="NoteNest向けテキスト(_N)..." Command="{Binding ExportNoteNestCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="終了(_X)" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="新規カード追加(_N)" InputGestureText="Ctrl+Shift+N"
                          Command="{Binding AddIdeaCommand}" />
                <Separator />
                <MenuItem Header="検索(_F)" InputGestureText="Ctrl+F"
                          Click="OnFocusSearchClick" />
                <Separator />
                <MenuItem Header="タグ管理(_T)..." Command="{Binding ManageTagsCommand}" />
                <Separator />
                <MenuItem Header="表示中カードをMarkdown形式でコピー(_C)" InputGestureText="Ctrl+Shift+C"
                          Command="{Binding CopyAllMarkdownCommand}" />
                <MenuItem Header="表示中カードをNoteNest向けにコピー(_N)"
                          Command="{Binding CopyNoteNestCommand}" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="アーカイブを表示" IsCheckable="True" IsChecked="{Binding ShowArchived, Mode=TwoWay}" />
            </MenuItem>
        </Menu>

        <!-- Search & filter bar -->
        <Border DockPanel.Dock="Top" Background="Transparent" Padding="20,14,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="タイトル・本文・タグを検索 (Ctrl+F)"
                             PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                             Padding="12,9,36,9" />
                    <Button Content="✕"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            ToolTip="検索をクリア (Esc)"
                            Visibility="{Binding SearchText, Converter={StaticResource StringToVis}}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding CountText}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
                <Border Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                        Visibility="{Binding SelectedTag, Converter={StaticResource StringToVis}}"
                        Background="{StaticResource ChipBackgroundBrush}"
                        CornerRadius="9" Padding="10,4">
                    <TextBlock Text="{Binding SelectedTag, StringFormat='#{0}'}"
                               Foreground="{StaticResource ChipForegroundBrush}" FontSize="12" />
                </Border>
                <CheckBox Grid.Column="3" Content="アーカイブを表示"
                          IsChecked="{Binding ShowArchived, Mode=TwoWay}"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Color filter strip -->
        <Border DockPanel.Dock="Top" Background="Transparent" Padding="20,0,20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="色:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="(すべて)"
                        Command="{Binding ClearColorCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        Padding="8,4" Margin="0,0,8,0"
                        ToolTip="色フィルタを解除" />
                <ListBox ItemsSource="{Binding ColorItems}"
                         SelectedValue="{Binding SelectedColor, Mode=TwoWay}"
                         SelectedValuePath="Name"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,4,0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Ring" Width="26" Height="26" CornerRadius="13"
                                                Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="2"
                                                Padding="2">
                                            <Ellipse Fill="{Binding Name, Converter={StaticResource ColorNameToBrush}}"
                                                     Stroke="#D1D5DB" StrokeThickness="1" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="#FFE4D2" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Status bar (must be declared before the fill Grid in DockPanel order) -->
        <Border DockPanel.Dock="Bottom" Background="Transparent" Padding="20,4"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" />
        </Border>

        <!-- Body: tag list + cards -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tag side panel: no hard border, breathable -->
            <Border Grid.Column="0" Background="Transparent" Padding="16,8,8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="タグ"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="6,4,0,8" />
                    <Button DockPanel.Dock="Top" Content="(すべて)"
                            Command="{Binding ClearTagCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            HorizontalContentAlignment="Left"
                            HorizontalAlignment="Stretch"
                            Padding="8,6" Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding TagItems}"
                             SelectedValue="{Binding SelectedTag, Mode=TwoWay}"
                             SelectedValuePath="Name"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFE4D2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Count}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" x:Name="CardArea">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,12"
                              Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisInverse}}">
                    <ItemsControl ItemsSource="{Binding VisibleCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardContainerStyle}"
                                        Width="252" Height="212"
                                        Background="{Binding BackgroundBrush, Converter={StaticResource HexToBrush}}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.EditIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Markdown形式でコピー(_C)"
                                                      Command="{Binding DataContext.CopyCardMarkdownCommand, Source={x:Reference CardArea}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="編集(_E)"
                                                      Command="{Binding DataContext.EditIdeaCommand, Source={x:Reference CardArea}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="ピン留め切替(_P)"
                                                      Command="{Binding DataContext.TogglePinCommand, Source={x:Reference CardArea}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="アーカイブ切替(_A)"
                                                      Command="{Binding DataContext.ToggleArchiveCommand, Source={x:Reference CardArea}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="削除(_D)"
                                                      Command="{Binding DataContext.DeleteIdeaCommand, Source={x:Reference CardArea}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel Margin="14">
                                        <!-- Header: pin + title -->
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="★" Foreground="#E0A800" FontSize="14"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <!-- Footer: action buttons -->
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="📌" ToolTip="ピン留め切替"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✎" ToolTip="編集"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.EditIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="📥" ToolTip="アーカイブ切替"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.ToggleArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="🗑" ToolTip="削除"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.DeleteIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <!-- Meta -->
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding UpdatedAtText}"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,2" />

                                        <!-- Tag chips -->
                                        <ItemsControl DockPanel.Dock="Bottom"
                                                      ItemsSource="{Binding TagsList}"
                                                      Margin="0,4,0,2">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TagChipStyle}">
                                                        <TextBlock Text="{Binding StringFormat='#{0}'}"
                                                                   Style="{StaticResource TagChipTextStyle}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Body preview -->
                                        <TextBlock Text="{Binding BodyPreview}"
                                                   TextWrapping="Wrap" Margin="0,2,0,4"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Opacity="0.85" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state placeholder -->
                <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               LineHeight="20" />
                </StackPanel>

                <!-- Floating action button: 新規アイデア -->
                <Button Style="{StaticResource FloatingAddButtonStyle}"
                        Content="＋"
                        ToolTip="新しいアイデアを追加 (Ctrl+Shift+N)"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,28,28"
                        Command="{Binding AddIdeaCommand}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
