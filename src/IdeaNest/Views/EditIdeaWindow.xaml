<Window x:Class="IdeaNest.Views.EditIdeaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アイデア編集"
        Width="600" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Margin="24" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect Color="#1F2937" Opacity="0.08" BlurRadius="14" ShadowDepth="2" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="タイトル" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16" />

            <TextBlock Grid.Row="2" Text="本文" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Row="3" Style="{StaticResource ModernTextBoxStyle}"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     MinHeight="200" Margin="0,0,0,16" />

            <TextBlock Grid.Row="4" Text="タグ (カンマ区切り)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Grid.Row="5" Style="{StaticResource ModernTextBoxStyle}"
                     Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                <TextBlock Text="色" Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,0" VerticalAlignment="Center" />
                <ComboBox Width="140" Padding="8,4"
                          ItemsSource="{Binding AvailableColors}"
                          SelectedItem="{Binding Color}" />
            </StackPanel>

            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,20">
                <CheckBox Content="ピン留め" IsChecked="{Binding IsPinned}"
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,20,0" />
                <CheckBox Content="アーカイブ" IsChecked="{Binding IsArchived}"
                          Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0" IsCancel="True" Click="OnCancel" />
                <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="OnOk" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
