<Application x:Class="IdeaNest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IdeaNest.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <conv:HexStringToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverse" Invert="True" />
        <conv:StringIsEmptyToVisibilityConverter x:Key="StringToVis" />

        <Style TargetType="Button" x:Key="FlatButton">
            <Setter Property="Background" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
